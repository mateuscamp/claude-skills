# Lista de permissão: só entram as skills próprias e os arquivos da raiz do
# repositório (README, CONTRIBUTING, AGENTS, LICENSE, distribuir.py, gerais-de-jogo.md, gerais-de-lua.md,
# tests/). synced/ é do app e use-railway é de terceiro; skill nova entra acrescentando a linha dela.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/AGENTS.md
!/LICENSE
!/distribuir.py
!/gerais-de-jogo.md
!/gerais-de-lua.md
!/tests/
!/ai-first-defold/
!/ai-first-godot/
!/ai-first-love/
!/code-audit/
!/arquitetura-ai-first/
!/python-on-rails/
!/jogos-ai-first/
!/revisao-de-capitulo/
!/revisao-de-livro/
